            "description": "Service is running and accessible"
          }
        },
        "security": []
      }
    },
    "/restore": {
      "get": {
        "summary": "Admin-only creation of tasks for all non-admin users",
        "description": "Requires a Bearer token belonging to an administrator.",
        "responses": {
          "200": {
            "description": "Successfully restored database with tasks for all non-admin users"
          },
          "401": {
            "description": "Invalid or missing API token"
          },
          "403": {
            "description": "Admin privileges required"
          },
          "500": {
            "description": "Failed to restore database"
          }
        }
