{
  "openapi": "3.0.0",
  "info": {
    "title": "LinkedInClone Server",
    "version": "1.0.0",
    "description": "Most endpoints require a Bearer JWT (obtained from POST /users/login). Admin-only endpoints return 403 for non-admin tokens."
  },
  "servers": [
    {
      "url": "http://localhost:3322"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Basic service health check endpoint",
        "description": "Only unauthenticated endpoint (other than api-docs). Returns a welcome message and timestamp.",
        "responses": {
          "200": {
            "description": "Service is running and accessible"
          }
        },
        "security": []
      }
    },
    "/restore": {
      "get": {
        "summary": "Admin-only reseed of the non-admin users, skills, posts, comments and connections",
        "description": "Requires a Bearer token belonging to an administrator. Wipes every skill, post, comment, connection and non-admin user, then recreates one test user per headshot in models/microsoft (username <forename><surname initial>, email <username>@microsoft.com, password \"testing\"), each holding a current Microsoft board seat that began at a random month between one and fifteen years ago, with 5 posts each, 0-4 comments on every post, a randomised network of accepted and pending connections, all backdated to random times over the last 60 days, and the 60-skill catalogue with roughly ten skills allotted to each user. Administrators are left untouched.",
        "responses": {
          "200": {
            "description": "Successfully restored database with users, posts, comments and connections"
          },
          "401": {
            "description": "Invalid or missing API token"
          },
          "403": {
            "description": "Admin privileges required"
          },
          "500": {
            "description": "Failed to restore database"
          }
        }
      }
    },
    "/posts/": {
      "get": {
        "summary": "Get all posts (newest first), author populated",
        "description": "",
        "parameters": [
          {
            "name": "author",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of posts"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      },
      "post": {
        "summary": "Create a post authored by the authenticated user",
        "description": "",
        "responses": {
          "201": {
            "description": "Post created"
          },
          "400": {
            "description": "Content is required, or imageUrl is not an http(s) URL"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Just shipped the Mongoose refactor!"
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/screenshot.png"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get a single post by ID, author populated",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested post"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "patch": {
        "summary": "Update a post's content or picture (author only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post updated"
          },
          "400": {
            "description": "imageUrl is not an http(s) URL"
          },
          "404": {
            "description": "Post not found or not owned by user"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Edited: shipped the refactor and the Swagger docs."
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/screenshot.png",
                    "description": "Send null or an empty string to remove the picture."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a post (author only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post deleted"
          },
          "404": {
            "description": "Post not found or not owned by user"
          }
        }
      }
    },
    "/posts/{postId}/likes": {
      "post": {
        "summary": "Like a post as the authenticated user (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post liked; returns the updated post"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "delete": {
        "summary": "Remove the authenticated user\\'s like from a post (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Like removed; returns the updated post"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Post not found"
          }
        }
      }
    },
    "/posts/{postId}/comments/": {
      "get": {
        "summary": "Get all comments on a post (oldest first), author populated",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of comments"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "post": {
        "summary": "Add a comment to a post as the authenticated user",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Comment created"
          },
          "400": {
            "description": "Comment content is required"
          },
          "404": {
            "description": "Post not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Great write-up, the populate() bit finally clicked."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts/{postId}/comments/{commentId}": {
      "get": {
        "summary": "Get a single comment on a post, author populated",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested comment"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      },
      "patch": {
        "summary": "Update a comment's content (comment author only)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comment updated"
          },
          "404": {
            "description": "Comment not found or not owned by user"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Edited: the populate() bit finally clicked."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a comment (comment author, or admin)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comment deleted"
          },
          "403": {
            "description": "Not allowed to delete this comment"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      }
    },
    "/posts/{postId}/comments/{commentId}/likes": {
      "post": {
        "summary": "Like a comment as the authenticated user (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comment liked; returns the updated comment"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      },
      "delete": {
        "summary": "Remove the authenticated user\\'s like from a comment (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Like removed; returns the updated comment"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      }
    },
    "/users/signup": {
      "post": {
        "summary": "Register a new user and return a JWT",
        "description": "",
        "responses": {
          "201": {
            "description": "User created; returns { token, user }"
          },
          "400": {
            "description": "Missing required fields or invalid values"
          },
          "409": {
            "description": "Email or username already registered"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "username",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nick Ross"
                  },
                  "username": {
                    "type": "string",
                    "example": "nickross"
                  },
                  "email": {
                    "type": "string",
                    "example": "nick@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "s3cr3tpw"
                  },
                  "biography": {
                    "type": "string",
                    "example": "FSD student"
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/avatar.png"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "summary": "Log in with email and password, returns a JWT",
        "description": "",
        "responses": {
          "200": {
            "description": "Authenticated; returns { token, user }"
          },
          "401": {
            "description": "Invalid credentials"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "nick@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "s3cr3tpw"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/": {
      "get": {
        "summary": "List all users (passwords excluded), decorated with your connection state",
        "description": "Each user arrives with their skill portfolio populated.",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get the authenticated user from their token",
        "description": "",
        "responses": {
          "200": {
            "description": "The current user"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get a user by ID (password excluded), decorated with your connection state",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "summary": "Update a user",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User updated"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nick Ross"
                  },
                  "username": {
                    "type": "string",
                    "example": "nickross"
                  },
                  "email": {
                    "type": "string",
                    "example": "nick@example.com"
                  },
                  "biography": {
                    "type": "string",
                    "example": "Updated bio"
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/avatar.png",
                    "description": "Send null or an empty string to remove the picture."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a user, along with their posts, comments, likes and connections",
        "description": "Skills they added to the catalogue survive them, since other users may hold them; they simply lose their creator, leaving only an admin able to edit them.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/{id}/connections": {
      "get": {
        "summary": "Get another user's accepted connections (newest first)",
        "description": "Accepted connections only, both ends populated: a pending request is between those two people and nobody else. You may only read this for yourself, or for someone you are already connected with; admins may read anyone.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of accepted connections"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "403": {
            "description": "Not connected with this user"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/{id}/skills": {
      "get": {
        "summary": "Get a user's skill portfolio",
        "description": "Readable by any authenticated user, like the profile itself.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of skills"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "post": {
        "summary": "Add a skill to a portfolio (your own, or anyone if you are an admin)",
        "description": "Send { skill } with the id of a catalogue skill, or { name, category } to add a brand new skill to the catalogue and the portfolio in one call. Adding a skill twice is a no-op rather than an error. Returns the full portfolio.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skill added; returns the portfolio"
          },
          "400": {
            "description": "Neither a valid skill id nor a name and category"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User or skill not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "skill": {
                    "type": "string",
                    "example": "6aa42b6454c881523762f1ea",
                    "description": "Id of an existing catalogue skill."
                  },
                  "name": {
                    "type": "string",
                    "example": "Underwater Basket Weaving",
                    "description": "Use with category instead of skill, to create and add in one call."
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "technical",
                      "business",
                      "extreme"
                    ],
                    "example": "extreme"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/skills/{skillId}": {
      "delete": {
        "summary": "Remove a skill from a portfolio (your own, or anyone if you are an admin)",
        "description": "Only the portfolio entry goes; the skill stays in the shared catalogue. Removing a skill the user does not hold is a no-op rather than an error. Returns the full portfolio.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skillId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skill removed; returns the portfolio"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/{id}/roles": {
      "get": {
        "summary": "Get a user's work history",
        "description": "Readable by any authenticated user, like the profile itself. Current roles come first, then the most recently begun. A role whose end is null is one the user still holds.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of roles"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "post": {
        "summary": "Add a role to a work history (your own, or anyone if you are an admin)",
        "description": "Months are \"YYYY-MM\". Leave end out, or send it as null, for a role the user still holds. Returns the whole history, in display order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Role added; returns the history"
          },
          "400": {
            "description": "Missing fields, a month that is not YYYY-MM, or an end before the start"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "company",
                  "start"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Board Member"
                  },
                  "company": {
                    "type": "string",
                    "example": "Microsoft"
                  },
                  "companyLogoUrl": {
                    "type": "string",
                    "example": "assets/ms-logo.png",
                    "description": "Served by the client from its own public folder."
                  },
                  "start": {
                    "type": "string",
                    "example": "2019-03"
                  },
                  "end": {
                    "type": "string",
                    "nullable": true,
                    "example": null,
                    "description": "null or an empty string for a role the user still holds."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/roles/{roleId}": {
      "put": {
        "summary": "Update a role (your own, or anyone if you are an admin)",
        "description": "A partial update: only the fields the body mentions are touched. Send end as null to reopen a role the user has gone back to, or as a month to close a current one. Returns the whole history, in display order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "roleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role updated; returns the history"
          },
          "400": {
            "description": "A month that is not YYYY-MM, or an end before the start"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User or role not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Chairman"
                  },
                  "company": {
                    "type": "string",
                    "example": "Microsoft"
                  },
                  "companyLogoUrl": {
                    "type": "string",
                    "example": "assets/ms-logo.png",
                    "description": "Send an empty string to remove the logo."
                  },
                  "start": {
                    "type": "string",
                    "example": "2019-03"
                  },
                  "end": {
                    "type": "string",
                    "nullable": true,
                    "example": "2024-11",
                    "description": "null or an empty string for a role the user still holds."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove a role from a work history (your own, or anyone if you are an admin)",
        "description": "Unlike a skill, a role exists only inside the user who held it, so removing one that is not there is a 404 rather than a no-op. Returns what is left of the history.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "roleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Role removed; returns the history"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User or role not found"
          }
        }
      }
    },
    "/dashboard/": {
      "get": {
        "summary": "Get the authenticated user's dashboard",
        "description": "",
        "responses": {
          "200": {
            "description": "The current user"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      }
    },
    "/dashboard/admin": {
      "get": {
        "summary": "Get the admin dashboard (admin only)",
        "description": "",
        "responses": {
          "200": {
            "description": "The current admin user"
          },
          "403": {
            "description": "Access denied"
          }
        }
      }
    },
    "/connections/": {
      "get": {
        "summary": "Get the authenticated user's connections and pending requests (newest first)",
        "description": "Returns every connection the authenticated user is part of, both ends populated. Narrow it with ?status=pending|accepted and ?direction=incoming|outgoing, where incoming means requests sent to you and outgoing means requests you sent.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of connections"
          },
          "400": {
            "description": "Invalid status or direction"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      },
      "post": {
        "summary": "Request a connection with another user",
        "description": "",
        "responses": {
          "201": {
            "description": "Connection request created"
          },
          "400": {
            "description": "Recipient missing, not a valid id, or the requester themselves"
          },
          "404": {
            "description": "Recipient not found"
          },
          "409": {
            "description": "Already connected, or a request is already pending"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipient"
                ],
                "properties": {
                  "recipient": {
                    "type": "string",
                    "example": "6aa42b6454c881523762f1ea",
                    "description": "Id of the user you want to connect with."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/connections/{id}/accept": {
      "post": {
        "summary": "Accept a pending connection request (recipient only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request accepted; returns the updated connection"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "No pending request with that id addressed to you"
          }
        }
      }
    },
    "/connections/{id}/reject": {
      "post": {
        "summary": "Reject a pending connection request (recipient only)",
        "description": "Deletes the request rather than marking it rejected, so the other user is free to ask again later.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request rejected"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "No pending request with that id addressed to you"
          }
        }
      }
    },
    "/connections/{id}": {
      "delete": {
        "summary": "Withdraw a request you sent, or disconnect from a user",
        "description": "Works on a pending request or an accepted connection, and either party may do it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection removed"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Connection not found, or you are not part of it"
          }
        }
      }
    },
    "/skills/": {
      "get": {
        "summary": "List the skill catalogue, decorated with how many users hold each skill",
        "description": "Every skill on the server, both the seeded catalogue and any a user has added. Narrow it with ?category=technical|business|extreme and ?q=<search>, which matches anywhere in the name. Each skill carries userCount and inPortfolio (whether you hold it).",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of skills"
          },
          "400": {
            "description": "Invalid category"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      },
      "post": {
        "summary": "Add a new skill to the shared catalogue",
        "description": "Any authenticated user may add a skill. It joins the catalogue for everyone, and only its creator (or an admin) can rename or delete it afterwards. Creating a skill does not add it to your own portfolio: POST /users/{id}/skills does that.",
        "responses": {
          "201": {
            "description": "Skill created"
          },
          "400": {
            "description": "Name missing, or category not one of the three"
          },
          "409": {
            "description": "A skill with that name already exists"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "category"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Underwater Basket Weaving"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "technical",
                      "business",
                      "extreme"
                    ],
                    "example": "extreme"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/skills/{id}": {
      "get": {
        "summary": "Get a single skill by ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
