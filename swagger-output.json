{
  "openapi": "3.0.0",
  "info": {
    "title": "LinkedInClone Server",
    "version": "1.0.0",
    "description": "Most endpoints require a Bearer JWT (obtained from POST /users/login). Admin-only endpoints return 403 for non-admin tokens."
  },
  "servers": [
    {
      "url": "http://localhost:3322"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Basic service health check endpoint",
        "description": "Only unauthenticated endpoint (other than api-docs). Returns a welcome message and timestamp.",
        "responses": {
          "200": {
            "description": "Service is running and accessible"
          }
        },
        "security": []
      }
    },
    "/restore": {
      "get": {
        "summary": "Admin-only reseed of the non-admin users, posts, comments and connections",
        "description": "Requires a Bearer token belonging to an administrator. Wipes every post, comment, connection and non-admin user, then recreates one test user per headshot in models/microsoft (username <forename><surname initial>, email <username>@microsoft.com, password \"testing\"), with 5 posts each, 0-4 comments on every post, and a randomised network of accepted and pending connections, all backdated to random times over the last 60 days. Administrators are left untouched.",
        "responses": {
          "200": {
            "description": "Successfully restored database with users, posts, comments and connections"
          },
          "401": {
            "description": "Invalid or missing API token"
          },
          "403": {
            "description": "Admin privileges required"
          },
          "500": {
            "description": "Failed to restore database"
          }
        }
      }
    },
    "/posts/": {
      "get": {
        "summary": "Get all posts (newest first), author populated",
        "description": "",
        "parameters": [
          {
            "name": "author",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of posts"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      },
      "post": {
        "summary": "Create a post authored by the authenticated user",
        "description": "",
        "responses": {
          "201": {
            "description": "Post created"
          },
          "400": {
            "description": "Content is required, or imageUrl is not an http(s) URL"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Just shipped the Mongoose refactor!"
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/screenshot.png"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "get": {
        "summary": "Get a single post by ID, author populated",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested post"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "patch": {
        "summary": "Update a post's content or picture (author only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post updated"
          },
          "400": {
            "description": "imageUrl is not an http(s) URL"
          },
          "404": {
            "description": "Post not found or not owned by user"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Edited: shipped the refactor and the Swagger docs."
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/screenshot.png",
                    "description": "Send null or an empty string to remove the picture."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a post (author only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post deleted"
          },
          "404": {
            "description": "Post not found or not owned by user"
          }
        }
      }
    },
    "/posts/{postId}/likes": {
      "post": {
        "summary": "Like a post as the authenticated user (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post liked; returns the updated post"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "delete": {
        "summary": "Remove the authenticated user\\'s like from a post (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Like removed; returns the updated post"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Post not found"
          }
        }
      }
    },
    "/posts/{postId}/comments/": {
      "get": {
        "summary": "Get all comments on a post (oldest first), author populated",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of comments"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Post not found"
          }
        }
      },
      "post": {
        "summary": "Add a comment to a post as the authenticated user",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Comment created"
          },
          "400": {
            "description": "Comment content is required"
          },
          "404": {
            "description": "Post not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Great write-up, the populate() bit finally clicked."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/posts/{postId}/comments/{commentId}": {
      "get": {
        "summary": "Get a single comment on a post, author populated",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested comment"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      },
      "patch": {
        "summary": "Update a comment's content (comment author only)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comment updated"
          },
          "404": {
            "description": "Comment not found or not owned by user"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "Edited: the populate() bit finally clicked."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a comment (comment author, or admin)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comment deleted"
          },
          "403": {
            "description": "Not allowed to delete this comment"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      }
    },
    "/posts/{postId}/comments/{commentId}/likes": {
      "post": {
        "summary": "Like a comment as the authenticated user (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comment liked; returns the updated comment"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      },
      "delete": {
        "summary": "Remove the authenticated user\\'s like from a comment (idempotent)",
        "description": "",
        "parameters": [
          {
            "name": "postId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Like removed; returns the updated comment"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Comment not found"
          }
        }
      }
    },
    "/users/signup": {
      "post": {
        "summary": "Register a new user and return a JWT",
        "description": "",
        "responses": {
          "201": {
            "description": "User created; returns { token, user }"
          },
          "400": {
            "description": "Missing required fields or invalid values"
          },
          "409": {
            "description": "Email or username already registered"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "username",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nick Ross"
                  },
                  "username": {
                    "type": "string",
                    "example": "nickross"
                  },
                  "email": {
                    "type": "string",
                    "example": "nick@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "s3cr3tpw"
                  },
                  "biography": {
                    "type": "string",
                    "example": "FSD student"
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/avatar.png"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "summary": "Log in with email and password, returns a JWT",
        "description": "",
        "responses": {
          "200": {
            "description": "Authenticated; returns { token, user }"
          },
          "401": {
            "description": "Invalid credentials"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "nick@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "s3cr3tpw"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/": {
      "get": {
        "summary": "List all users (passwords excluded), decorated with your connection state",
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get the authenticated user from their token",
        "description": "",
        "responses": {
          "200": {
            "description": "The current user"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get a user by ID (password excluded), decorated with your connection state",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "summary": "Update a user",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User updated"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nick Ross"
                  },
                  "username": {
                    "type": "string",
                    "example": "nickross"
                  },
                  "email": {
                    "type": "string",
                    "example": "nick@example.com"
                  },
                  "biography": {
                    "type": "string",
                    "example": "Updated bio"
                  },
                  "imageUrl": {
                    "type": "string",
                    "example": "https://example.com/avatar.png",
                    "description": "Send null or an empty string to remove the picture."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a user, along with their posts, comments, likes and connections",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/dashboard/": {
      "get": {
        "summary": "Get the authenticated user's dashboard",
        "description": "",
        "responses": {
          "200": {
            "description": "The current user"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      }
    },
    "/dashboard/admin": {
      "get": {
        "summary": "Get the admin dashboard (admin only)",
        "description": "",
        "responses": {
          "200": {
            "description": "The current admin user"
          },
          "403": {
            "description": "Access denied"
          }
        }
      }
    },
    "/connections/": {
      "get": {
        "summary": "Get the authenticated user's connections and pending requests (newest first)",
        "description": "Returns every connection the authenticated user is part of, both ends populated. Narrow it with ?status=pending|accepted and ?direction=incoming|outgoing, where incoming means requests sent to you and outgoing means requests you sent.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of connections"
          },
          "400": {
            "description": "Invalid status or direction"
          },
          "401": {
            "description": "Invalid or missing token"
          }
        }
      },
      "post": {
        "summary": "Request a connection with another user",
        "description": "",
        "responses": {
          "201": {
            "description": "Connection request created"
          },
          "400": {
            "description": "Recipient missing, not a valid id, or the requester themselves"
          },
          "404": {
            "description": "Recipient not found"
          },
          "409": {
            "description": "Already connected, or a request is already pending"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipient"
                ],
                "properties": {
                  "recipient": {
                    "type": "string",
                    "example": "6aa42b6454c881523762f1ea",
                    "description": "Id of the user you want to connect with."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/connections/{id}/accept": {
      "post": {
        "summary": "Accept a pending connection request (recipient only)",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request accepted; returns the updated connection"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "No pending request with that id addressed to you"
          }
        }
      }
    },
    "/connections/{id}/reject": {
      "post": {
        "summary": "Reject a pending connection request (recipient only)",
        "description": "Deletes the request rather than marking it rejected, so the other user is free to ask again later.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request rejected"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "No pending request with that id addressed to you"
          }
        }
      }
    },
    "/connections/{id}": {
      "delete": {
        "summary": "Withdraw a request you sent, or disconnect from a user",
        "description": "Works on a pending request or an accepted connection, and either party may do it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection removed"
          },
          "401": {
            "description": "Invalid or missing token"
          },
          "404": {
            "description": "Connection not found, or you are not part of it"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}