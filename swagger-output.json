            "description": "The skill"
          },
          "404": {
            "description": "Skill not found"
          }
        }
      },
      "put": {
        "summary": "Rename or recategorise a skill (creator or admin only)",
        "description": "Other users may already hold this skill, so editing is limited to whoever added it. Seeded catalogue skills have no creator and can only be edited by an admin.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skill updated"
          },
          "403": {
            "description": "Not your skill"
          },
          "404": {
            "description": "Skill not found"
          },
          "409": {
            "description": "Another skill already has that name"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Underwater Basket Weaving"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "technical",
                      "business",
                      "extreme"
                    ],
                    "example": "extreme"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a skill from the catalogue (creator or admin only)",
        "description": "Also removes the skill from every portfolio holding it, since there are no foreign keys to do it for us. Returns how many users were affected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skill deleted"
          },
          "403": {
            "description": "Not your skill"
          },
          "404": {
            "description": "Skill not found"
          }
        }
      }
